# Optional. The studio defaults to https://api.higgsfield.ai when this is unset.
HF_API_BASE_URL=
# Vercel Blob read-write token. Required for uploads (Genjutsu video and reference images).
OPEN_HIGGSFIELD_READ_WRITE_TOKEN=

# Supabase. Leave both empty to run without sign-in.
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...). The legacy anon key also works,
# set as NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Encrypts saved API keys. Generate with: openssl rand -base64 32
# Use the same value in every environment that shares the database.
OHF_KEY_ENCRYPTION_SECRET=
